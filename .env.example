# Copy to .env for LOCAL scripts only. Never commit the real file.
# PUBLIC (also goes in config.js): safe for browsers
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# SECRET: only for migration/import.mjs and scripts/admin-reset-password.mjs, run on your own computer. Never in the website.
SUPABASE_SERVICE_ROLE_KEY=
# Tests refuse to run unless this is "yes". Only use a throwaway DEV project.
DEV_PROJECT_CONFIRM=no
# Only if you set a sign-up code on the Edge Function (supabase secrets set SIGNUP_CODE=...). The tests need it to create users.
SIGNUP_CODE=
